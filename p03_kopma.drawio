        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide methods\nskinparam linetype ortho\n\n&#39; Pengaturan posisi layout agar tidak bertabrakan\npetugas -[hidden]down-&gt; anggota\nanggota -[hidden]down-&gt; pemasok\n\npemasok -[hidden]right-&gt; pembelian\nanggota -[hidden]right-&gt; penjualan\npetugas -[hidden]right-&gt; penjualan\n\npenjualan -[hidden]right-&gt; barang\npembelian -[hidden]right-&gt; detail_pembelian\n\nentity \&quot;petugas\&quot; as petugas {\n  * id_petugas : smallint [PK]\n  --\n  kode_petugas : char(3)\n  nama_petugas : varchar(160)\n  peran_petugas : enum\n}\n\nentity \&quot;anggota\&quot; as anggota {\n  * id_anggota : int [PK]\n  --\n  no_anggota : char(6)\n  nim_anggota : char(10)\n  nama_anggota : varchar(100)\n  prodi_anggota : varchar(60)\n  no_hp_anggota : varchar(15)\n  status_anggota : enum\n  tgl_daftar_anggota : date\n}\n\nentity \&quot;pemasok\&quot; as pemasok {\n  * id_pemasok : int [PK]\n  --\n  nama_pemasok : varchar(100)\n  telepon_pemasok : varchar(15)\n  alamat_pemasok : varchar(200)\n}\n\nentity \&quot;penjualan\&quot; as penjualan {\n  * id_penjualan : int [PK]\n  --\n  no_nota_penjualan : char(12)\n  tgl_penjualan : datetime\n  # id_petugas : smallint [FK]\n  # id_anggota : int [FK]\n  bayar_penjualan : decimal\n}\n\nentity \&quot;pembelian\&quot; as pembelian {\n  * id_pembelian : int [PK]\n  --\n  no_faktur_pembelian : varchar(20)\n  tgl_pembelian : date\n  # id_pemasok : int [FK]\n  status_pembelian : enum\n}\n\nentity \&quot;barang\&quot; as barang {\n  * id_barang : int [PK]\n  --\n  kode_barang : varchar(10)\n  nama_barang : varchar(100)\n  kategori_barang : enum\n  harga_jual_barang : decimal\n  stok_barang : int\n  stok_min_barang : int\n}\n\nentity \&quot;detail_penjualan\&quot; as detail_penjualan {\n  * id_penjualan : int [PK, FK]\n  * id_barang : int [PK, FK]\n  --\n  qty_detail_penjualan : smallint\n  harga_satuan_detail_penjualan : decimal\n}\n\nentity \&quot;detail_pembelian\&quot; as detail_pembelian {\n  * id_pembelian : int [PK, FK]\n  * id_barang : int [PK, FK]\n  --\n  qty_detail_pembelian : int\n  harga_beli_detail_pembelian : decimal\n}\n\n&#39; Relasi antar tabel\npetugas ||--o{ penjualan\nanggota ||--o{ penjualan\npenjualan ||--|{ detail_penjualan\nbarang ||--o{ detail_penjualan\n\npemasok ||--o{ pembelian\npembelian ||--|{ detail_pembelian\nbarang ||--o{ detail_pembelian\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9L5xCHjFho5NLMxtKW1n-179">
